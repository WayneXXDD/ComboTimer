<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>WayneComboTimer</AssemblyName>
    <Version>1.1.0.2</Version>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DalamudDir Condition="'$(DalamudDir)' == ''">$(APPDATA)\XIVLauncher\addon\Hooks\dev</DalamudDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Dalamud;Dalamud.Bindings.ImGui;FFXIVClientStructs;InteropGenerator.Runtime;Lumina;Lumina.Excel">
      <HintPath>$(DalamudDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
